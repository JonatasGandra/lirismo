# Copie para .env.local e preencha. Na Vercel: Settings → Environment Variables.

# Supabase → Project Settings → API (URL do projeto)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Supabase → Project Settings → API Keys (chave pública: "anon" ou "publishable")
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# String aleatória longa. A Vercel envia como "Authorization: Bearer ..." no cron de keep-alive.
CRON_SECRET=
